---
// Small inline icons shared by the pages (stroke follows currentColor).
interface Props { name: 'arrow' | 'out' | 'down' | 'copy' | 'mail' | 'back' }
const { name } = Astro.props;
---
{name === 'arrow' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'back' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16 10H5m4.5-4.5L5 10l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'out' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 13l6.5-6.5M8 6.5h5.5V12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'down' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v10m-4.5-4.5L10 14l4.5-4.5M5 16.5h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'copy' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="7" y="7" width="9" height="9" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7" stroke="currentColor" stroke-width="1.6"/></svg>}
{name === 'mail' && <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="m3.5 6 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
