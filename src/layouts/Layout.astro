---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "El Mahdi Moubarak - Senior Software Engineer · SaaS & AI", noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navLinks = [
  { href: `${base}/`, label: "Home" },
  { href: `${base}/portfolio`, label: "Portfolio" },
  { href: `${base}/blog`, label: "Blog" },
  { href: `${base}/cv`, label: "CV" },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <title>{title}</title>
  <script is:inline>
    (function() {
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col">

  <header class="border-b-2 border-ink dark:border-dark-border py-4 sticky top-0 z-50 bg-paper dark:bg-dark-paper">
    <nav class="max-w-3xl mx-auto px-5 flex items-center justify-between">
      <a href={`${base}/`} class="font-mono text-sm font-bold tracking-tight hover:text-accent transition-colors">
        emoubarak
      </a>

      <div class="flex items-center gap-5">
        {navLinks.map(link => (
          <a href={link.href} class="font-mono text-xs font-medium text-muted hover:text-ink dark:hover:text-dark-ink transition-colors">
            {link.label}
          </a>
        ))}

        <a
          href="https://github.com/emoubarak"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="text-muted hover:text-ink dark:hover:text-dark-ink transition-colors"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>

        <button
          id="theme-toggle"
          class="b-border w-8 h-8 flex items-center justify-center text-xs font-mono font-bold cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors"
          aria-label="Toggle dark mode"
        >
          <span id="icon-light" class="dark:hidden">D</span>
          <span id="icon-dark" class="hidden dark:inline">L</span>
        </button>
      </div>
    </nav>
  </header>

  <main class="flex-1 max-w-3xl mx-auto px-5 py-12 w-full">
    <slot />
  </main>

  <footer class="border-t-2 border-ink dark:border-dark-border py-6">
    <div class="max-w-3xl mx-auto px-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-muted">
      <span>&copy; {new Date().getFullYear()} El Mahdi Moubarak</span>
      <div class="flex gap-4">
        <a href="mailto:elmahdi@moubarak.dev" class="hover:text-ink dark:hover:text-dark-ink transition-colors">email</a>
        <a href="https://linkedin.com/in/el-mahdi-moubarak" target="_blank" class="hover:text-ink dark:hover:text-dark-ink transition-colors">linkedin</a>
        <a href="https://github.com/emoubarak" target="_blank" class="hover:text-ink dark:hover:text-dark-ink transition-colors">github</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const h = document.documentElement;
      h.classList.toggle('dark');
      localStorage.setItem('theme', h.classList.contains('dark') ? 'dark' : 'light');
    });
  </script>
</body>
</html>
