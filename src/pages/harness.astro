---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { identity } from '../data/profile.js';
import { harness } from '../data/harness.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (p: string) => `${base}${p}`;
const { counted, stats, journey, districts, agents, skills, sourcing, hooks, clock, bench, openSource, workshop, lessons } = harness;

// map of the hero: a 3 × 3 city, one block per district, roads between them
const B = { w: 156, h: 132, gx: 36, gy: 34, x0: 14, y0: 14 };
const blocks = districts.map((d, i) => ({
  ...d,
  x: B.x0 + (i % 3) * (B.w + B.gx),
  y: B.y0 + Math.floor(i / 3) * (B.h + B.gy),
}));
const roadX = [B.x0 + B.w + B.gx / 2, B.x0 + 2 * B.w + 1.5 * B.gx];
const roadY = [B.y0 + B.h + B.gy / 2, B.y0 + 2 * B.h + 1.5 * B.gy];
const W = B.x0 * 2 + 3 * B.w + 2 * B.gx;
const H = B.y0 * 2 + 3 * B.h + 2 * B.gy;
// the routes the little couriers drive along (they only use roads)
const routes = [
  `M ${roadX[0]} 0 V ${roadY[1]} H ${W}`,
  `M 0 ${roadY[0]} H ${roadX[1]} V ${H}`,
  `M ${W} ${roadY[0]} H ${roadX[0]} V ${roadY[1]} H 0`,
];

// 24-hour dial
const R = 150, C = 190;
const at = (h: number, r = R) => {
  const a = (h / 24) * Math.PI * 2 - Math.PI / 2;
  return { x: C + r * Math.cos(a), y: C + r * Math.sin(a) };
};
const arc = (h0: number, h1: number, r: number) => {
  const p0 = at(h0, r), p1 = at(h1, r);
  const large = h1 - h0 > 12 ? 1 : 0;
  return `M ${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A ${r} ${r} 0 ${large} 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
};
const benchMax = 10;
---

<Layout
  title="The harness - El Mahdi Moubarak"
  description="How one person runs AI agents on a handful of machines: skills, hooks, routines, browser agents, memory and a local 180B model, with what each part checks and what broke."
  ogImage="/og/harness.png?v=2"
>
  <PageHero eyebrow="Behind the work">
    <h1 class="t-page">
      <span class="rise"><span style="--i:0">The</span></span>
      <span class="rise"><span style="--i:1">harness</span></span>
    </h1>
    <p class="t-lede hero__lede fade-up" style="--i:1">
      The setup I built to let AI agents work on my own machines, and the checks that tell me when a task is done.
    </p>
    <div class="hero__actions fade-up" style="--i:2">
      <a href="#journey" class="btn btn--solid">Take the tour <Icon name="arrow" /></a>
      <a href="#open-source" class="btn btn--line">Open-source parts</a>
    </div>
    <p class="t-meta mt-6 fade-up" style="--i:3">Click a block of the city to jump to it.</p>

    <div slot="visual" class="city-wrap">
      <svg class="city" viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of the harness: nine districts joined by roads">
        <g class="city__roads" aria-hidden="true">
          {roadX.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
          {roadY.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
        </g>
        <g aria-hidden="true">
          {routes.map((d, i) => <circle class="city__car" r="5.5" style={`offset-path: path('${d}'); --d:${9 + i * 2.5}s; --delay:${-i * 3.1}s`} />)}
        </g>
        {blocks.map((b, i) => (
          <a href={`#${b.anchor ?? b.id}`} class="city__block" style={`--i:${i}`} aria-label={`${b.name}: ${b.tag}`}>
            <rect x={b.x} y={b.y} width={B.w} height={B.h} rx="16" />
            <g transform={`translate(${b.x + 18} ${b.y + 18})`} class="city__icon" aria-hidden="true" set:html={b.icon} />
            <text x={b.x + 18} y={b.y + B.h - 40} class="city__name">{b.name}</text>
            <text x={b.x + 18} y={b.y + B.h - 20} class="city__tag">{b.tag}</text>
            {b.id === 'vault' && (
              <g class="city__flag" aria-hidden="true">
                <line x1={b.x + B.w - 26} y1={b.y + 16} x2={b.x + B.w - 26} y2={b.y + 50} />
                <path d={`M ${b.x + B.w - 26} ${b.y + 16} h 18 l -5 7 l 5 7 h -18 z`} />
              </g>
            )}
          </a>
        ))}
      </svg>
    </div>
  </PageHero>

  <div class="after-hero">
    <!-- Numbers -->
    <section class="wrap pt-[clamp(3.5rem,7vw,6.5rem)]">
      <div class="stats">
        {stats.map((s, i) => (
          <div class="stat" data-reveal style={`--i:${i}`}>
            <p class="stat__n">{s.n}</p>
            <p class="stat__l">{s.label}</p>
          </div>
        ))}
      </div>
      <p class="t-meta mt-5">One person, a mini PC with an external GPU, a home server, two laptops, two phones and a small VPS, on one private network.</p>
    </section>

    <!-- Life of a prompt -->
    <section id="journey" class="section wrap">
      <div class="band-ink px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(3rem,6vw,5.5rem)]">
        <div class="max-w-[46rem]">
          <p class="t-eyebrow mb-4">The tour</p>
          <h2 class="t-h2">Life of a prompt</h2>
          <p class="text-2 text-[1.1rem] leading-relaxed mt-5">What happens between my prompt and the moment I accept that something is done.</p>
        </div>
        <ol class="journey" style={`--n:${journey.length}`}>
          <span class="journey__track" aria-hidden="true"><span class="journey__dot"></span></span>
          {journey.map((j, i) => (
            <li class="journey__stop" data-reveal style={`--i:${i}`}>
              <span class="journey__icon" aria-hidden="true" set:html={j.icon} />
              <h3 class="journey__title">{j.title}</h3>
              <p class="journey__text">{j.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Districts -->
    <section class="section wrap">
      <div class="s-head">
        <div>
          <p class="t-eyebrow">The city</p>
          <h2 class="t-h2">Nine districts</h2>
        </div>
        <a href={`${base}/blog/one-person-it-department`} class="link-arrow shrink-0 mb-2">The long version (22 Nov) <Icon name="arrow" /></a>
      </div>

      <div class="districts">
        {districts.filter((d) => !d.hidden).map((d, i) => (
          <article id={d.id} class:list={['district', `district--${d.layout}`]} data-reveal>
            <div class="district__text">
              <p class="district__kicker"><span class="district__icon" aria-hidden="true" set:html={d.icon} />{d.kicker ?? d.name}</p>
              <h3 class="t-h3">{d.title ?? d.name}</h3>
              <p class="text-2 leading-relaxed mt-4">{d.what}</p>
              <ul class="district__list">
                {d.points.map((p) => <li set:html={p} />)}
              </ul>
              {d.incident && (
                <aside class="incident">
                  <p class="incident__head">Incident report</p>
                  <p set:html={d.incident} />
                </aside>
              )}
            </div>
            <div class="district__visual">
              {d.visual?.kind === 'image' && (
                <a href={img(d.visual.src)} class="shot" target="_blank" rel="noopener">
                  <img src={img(d.visual.src)} alt={d.visual.alt} width={d.visual.w} height={d.visual.h} loading="lazy" decoding="async" />
                </a>
              )}
              {d.visual?.kind === 'rules' && (
                <div class="rulefile" aria-label="The instruction file is capped at 120 lines by a hook">
                  <div class="rulefile__bar"><span>CLAUDE.md</span><span>120 / 120</span></div>
                  <ol>
                    {d.visual.lines.map((l: string) => <li>{l}</li>)}
                    <li class="rulefile__refused">Line 121 refused by a hook. Make room or move it to a project.</li>
                  </ol>
                </div>
              )}
              {d.visual?.kind === 'clock' && (
                <figure class="dial">
                  <svg viewBox="0 0 380 380" role="img" aria-label="24-hour dial of the scheduled routines">
                    <circle cx={C} cy={C} r={R} class="dial__ring" />
                    <circle cx={C} cy={C} r={R - 26} class="dial__ring dial__ring--dash" data-ev={clock.findIndex((e) => e.ring)} />
                    <path d={arc(1, 7, R + 14)} class="dial__arc" />
                    {Array.from({ length: 24 }, (_, h) => {
                      const a = at(h, R - 8), b2 = at(h, R + 4), t = at(h, R - 30);
                      return (
                        <g>
                          <line x1={a.x} y1={a.y} x2={b2.x} y2={b2.y} class:list={['dial__tick', { 'dial__tick--major': h % 6 === 0 }]} />
                          {h % 6 === 0 && <text x={t.x} y={t.y + 4} class="dial__hour">{String(h).padStart(2, '0')}</text>}
                        </g>
                      );
                    })}
                    {clock.flatMap((e, i) => (e.hs ?? (e.h != null ? [e.h] : [])).map((h) => {
                      const p = at(h, R);
                      return <circle cx={p.x} cy={p.y} r="8" class="dial__ev" data-ev={i} />;
                    }))}
                    <text x={C} y={C - 6} class="dial__center">24 h</text>
                    <text x={C} y={C + 18} class="dial__center-l">of routines</text>
                  </svg>
                  <ul class="dial__legend">
                    {clock.map((e, i) => (
                      <li data-ev={i} tabindex="0"><span class="t-meta">{e.time}</span>{e.what}</li>
                    ))}
                  </ul>
                  {d.visual.src && (
                    <a href={img(d.visual.src)} class="shot dial__shot" target="_blank" rel="noopener">
                      <img src={img(d.visual.src)} alt={d.visual.alt} width={d.visual.w} height={d.visual.h} loading="lazy" decoding="async" />
                    </a>
                  )}
                </figure>
              )}
              {d.visual?.kind === 'project' && (
                <div class="proj" aria-label="A project in the inventory owns several things">
                  <div class="proj__core"><span class="t-meta">one card per</span><b>Project</b><span class="t-meta">a thing that exists in the world</span></div>
                  <ul class="proj__parts">
                    {d.visual.parts.map((pt: string, i: number) => <li style={`--i:${i}`}>{pt}</li>)}
                  </ul>
                </div>
              )}
              {d.visual?.kind === 'backup' && (
                <div class="backup" aria-label="Timeline of the backup that died silently">
                  {d.visual.steps.map((s: { date: string; text: string; state: string }) => (
                    <div class:list={['backup__step', `is-${s.state}`]}>
                      <span class="backup__date">{s.date}</span>
                      <span class="backup__dot" aria-hidden="true"></span>
                      <span class="backup__text">{s.text}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Agents -->
    <section id="agents" class="section wrap">
      <div class="grid lg:grid-cols-12 gap-x-16 gap-y-6 items-end">
        <div class="lg:col-span-6">
          <p class="t-eyebrow mb-4">The staff</p>
          <h2 class="t-h2">The agents and what they share</h2>
        </div>
        <p class="lg:col-span-6 text-2 text-[1.1rem] leading-relaxed">{agents.intro}</p>
      </div>
      <div class="crew">
        <div class="crew__hub" data-reveal>
          <p class="crew__hub-title">{agents.hub.title}</p>
          <ul>{agents.hub.items.map((it) => <li>{it}</li>)}</ul>
        </div>
        {agents.list.map((a, i) => (
          <article class="agent" data-reveal style={`--i:${i % 3}`}>
            <div class="agent__top"><span class="agent__icon" aria-hidden="true" set:html={a.icon} /><h3 class="agent__name">{a.name}</h3></div>
            <p class="agent__role">{a.role}</p>
            <dl class="agent__dl">
              <div><dt>Model</dt><dd>{a.brains}</dd></div>
              <div><dt>Rules</dt><dd>{a.rules}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="section wrap">
      <div class="s-head">
        <div>
          <p class="t-eyebrow">Training department</p>
          <h2 class="t-h2">My own skills</h2>
        </div>
      </div>
      <p class="text-2 text-[1.1rem] leading-relaxed max-w-[60ch] -mt-4">{skills.intro}</p>
      <div class="skills">
        {skills.items.map((s, i) => (
          <article class="skill" data-reveal style={`--i:${i % 3}`}>
            <div class="skill__top">
              <span class="skill__icon" aria-hidden="true" set:html={s.icon} />
              <code class="skill__name">{s.name}</code>
            </div>
            <p class="skill__text">{s.text}</p>
          </article>
        ))}
      </div>
      {skills.note && <p class="t-meta mt-6">{skills.note}</p>}
    </section>

    <!-- Sourcing -->
    <section id="sourcing" class="section wrap">
      <div class="grid lg:grid-cols-12 gap-x-16 gap-y-6 items-end">
        <div class="lg:col-span-6">
          <p class="t-eyebrow mb-4">Research and development</p>
          <h2 class="t-h2">Where the skills come from</h2>
        </div>
        <p class="lg:col-span-6 text-2 text-[1.1rem] leading-relaxed">{sourcing.intro}</p>
      </div>
      <ol class="pipe">
        {sourcing.steps.map((st, i) => (
          <li class="pipe__step" data-reveal style={`--i:${i}`}>
            <span class="pipe__icon" aria-hidden="true" set:html={st.icon} />
            <h3 class="pipe__title">{st.title}</h3>
            <p class="pipe__text">{st.text}</p>
            <p class="pipe__check"><span aria-hidden="true">✓</span>{st.check}</p>
          </li>
        ))}
      </ol>
      <div class="cases">
        {sourcing.examples.map((ex, i) => (
          <article class="case" data-reveal style={`--i:${i}`}>
            <p class="case__from">{ex.from}</p>
            <h3 class="case__title">{ex.title}</h3>
            <p class="case__text">{ex.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Hooks -->
    <section id="hooks" class="section wrap">
      <div class="band-paper px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(3rem,6vw,5.5rem)]">
        <div class="max-w-[46rem]">
          <p class="t-eyebrow mb-4">Policy handbook</p>
          <h2 class="t-h2">Rules that became code</h2>
          <p class="text-2 text-[1.1rem] leading-relaxed mt-5">When the model breaks a rule twice, I turn the rule into a hook: a script that runs before or after the model acts, and can refuse what it is about to do.</p>
        </div>
        <div class="hooks">
          {hooks.map((h, i) => (
            <article class="hook" data-reveal style={`--i:${i % 3}`}>
              <p class="hook__when">{h.when}</p>
              <p class="hook__before"><span>Why</span>{h.before}</p>
              <p class="hook__after"><span>What the hook does</span>{h.after}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Local model bench -->
    <section id="bench" class="section wrap">
      <div class="grid lg:grid-cols-12 gap-x-16 gap-y-10 items-start">
        <div class="lg:col-span-5">
          <p class="t-eyebrow mb-4">Measured</p>
          <h2 class="t-h2">Is the local model worth it?</h2>
          <p class="text-2 text-[1.1rem] leading-relaxed mt-5">{bench.intro}</p>
          <p class="text-2 leading-relaxed mt-4">{bench.verdict}</p>
          <a href={`${base}/blog/then-i-bought-a-gpu`} class="link-arrow mt-6">The GPU setup and its speeds <Icon name="arrow" /></a>
        </div>
        <div class="lg:col-span-7">
          <div class="bench" role="table" aria-label="Same bug fixes done five ways, scored by a judge model">
            <div class="bench__head" role="row">
              <span role="columnheader">Who fixes it</span>
              <span role="columnheader">Quality (judge, out of 10)</span>
              <span role="columnheader">My wait</span>
            </div>
            {bench.rows.map((r, i) => (
              <div class:list={['bench__row', { 'is-best': r.best }]} role="row" data-reveal style={`--i:${i}`}>
                <span role="cell" class="bench__who">{r.who}</span>
                <span role="cell" class="bench__q">
                  <span class="bench__bar"><span style={`width:${(r.q / benchMax) * 100}%`}></span></span>
                  <b>{r.q.toFixed(1)}</b>
                </span>
                <span role="cell" class="t-meta">{r.wait}</span>
              </div>
            ))}
          </div>
          <p class="t-meta mt-4">{bench.note}</p>
        </div>
      </div>
    </section>

    <!-- Open source -->
    <section id="open-source" class="section wrap">
      <div class="s-head">
        <div>
          <p class="t-eyebrow">Take it home</p>
          <h2 class="t-h2">Open-source parts</h2>
        </div>
        <a href={identity.github} target="_blank" rel="noopener noreferrer" class="link-arrow shrink-0 mb-2">GitHub <Icon name="out" /></a>
      </div>
      <div class="repos">
        {openSource.map((r, i) => (
          <a href={r.url} target="_blank" rel="noopener noreferrer" class="repo" data-reveal style={`--i:${i % 4}`}>
            <span class="repo__name">{r.name} <Icon name="out" /></span>
            <span class="repo__text">{r.text}</span>
            {r.proof && <span class="repo__proof">{r.proof}</span>}
            <span class="t-meta">{r.stack}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Workshop -->
    <section id="workshop" class="section wrap">
      <div class="band-ink px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(3rem,6vw,5.5rem)]">
        <div class="max-w-[46rem]">
          <p class="t-eyebrow mb-4">The workshop</p>
          <h2 class="t-h2">Small tools around the setup</h2>
          <p class="text-2 text-[1.1rem] leading-relaxed mt-5">Each one exists because I hit the same problem twice.</p>
        </div>
        <ul class="workshop">
          {workshop.map((w, i) => {
            const Tag = w.url ? 'a' : 'div';
            return (
              <li data-reveal style={`--i:${i % 3}`}>
                <Tag class="tool" {...(w.url ? { href: w.url, target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <span class="tool__icon" aria-hidden="true" set:html={w.icon} />
                  <span class="tool__body">
                    <span class="tool__name">{w.name} <span class="tool__tag">{w.tag}</span></span>
                    <span class="tool__text">{w.text}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- Lessons -->
    <section class="section wrap">
      <div class="grid lg:grid-cols-12 gap-x-16 gap-y-8">
        <div class="lg:col-span-4">
          <p class="t-eyebrow mb-4">If you run one too</p>
          <h2 class="t-h2">What I'd tell you</h2>
        </div>
        <ul class="lessons lg:col-span-8">
          {lessons.map((l, i) => (
            <li data-reveal style={`--i:${i % 2}`}><strong>{l.title}</strong> {l.text}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section class="wrap pb-[var(--section)]">
      <div class="band-orange on-orange px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3rem,7vw,6rem)] grid lg:grid-cols-12 gap-10 items-end" data-reveal>
        <div class="lg:col-span-7">
          <p class="t-eyebrow mb-6">Contact</p>
          <h2 class="t-page">Want one for your team?</h2>
          <p class="t-lede mt-6 max-w-[36ch]">I set up agents on your own servers, with tests, a database query or a second model checking their work.</p>
        </div>
        <div class="lg:col-span-5 flex flex-col items-start gap-4 lg:items-end">
          <a href={identity.calendly} target="_blank" rel="noopener noreferrer" class="btn btn--solid">Book a call <Icon name="arrow" /></a>
          <a href={`mailto:${identity.email}`} class="btn btn--line">{identity.email}</a>
          <div class="flex gap-6 mt-2 font-semibold">
            <a href={`${base}/cv`} class="link">CV</a>
            <a href={identity.linkedin} target="_blank" rel="noopener noreferrer" class="link">LinkedIn ↗</a>
            <a href={identity.github} target="_blank" rel="noopener noreferrer" class="link">GitHub ↗</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  // dial: hovering or focusing a legend line lights its mark on the clock, and the reverse
  document.querySelectorAll('.dial').forEach(function (dial) {
    function set(i) {
      dial.querySelectorAll('[data-ev]').forEach(function (el) { el.classList.toggle('is-on', el.getAttribute('data-ev') === i); });
    }
    dial.querySelectorAll('[data-ev]').forEach(function (el) {
      el.addEventListener('mouseenter', function () { set(el.getAttribute('data-ev')); });
      el.addEventListener('focus', function () { set(el.getAttribute('data-ev')); });
      el.addEventListener('mouseleave', function () { set(null); });
      el.addEventListener('blur', function () { set(null); });
    });
  });
</script>

<style>
  /* ── hero city ── */
  .city-wrap { height: 100%; display: flex; align-items: center; justify-content: flex-end; padding-top: var(--header-h); padding-bottom: 2rem; }
  .city { width: 100%; max-width: 40rem; height: auto; overflow: visible; }
  .city__roads line { stroke: rgb(20 22 26 / 0.28); stroke-width: 3; stroke-dasharray: 10 9; }
  .city__car { fill: #14161a; offset-rotate: 0deg; animation: drive var(--d) linear infinite; animation-delay: var(--delay); }
  @keyframes drive { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  .city__block rect { fill: #fff; stroke: #14161a; stroke-width: 2.2; transition: fill 0.25s, transform 0.35s var(--ease-out); transform-box: fill-box; transform-origin: center; }
  .city__block { cursor: pointer; outline: none; }
  .city__block:hover rect, .city__block:focus-visible rect { fill: #14161a; }
  .city__block:hover text, .city__block:focus-visible text { fill: #fff; }
  .city__block:hover .city__icon, .city__block:focus-visible .city__icon { color: #fc7b42; }
  .city__block:focus-visible rect { stroke: #fff; stroke-width: 3; }
  .city__icon { color: #14161a; transition: color 0.25s; }
