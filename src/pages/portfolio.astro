---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { projects, projectCategories } from '../data/profile.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Only the categories that have projects, each with its count
const categories = projectCategories
  .map((c) => ({ ...c, n: c.key === 'all' ? projects.length : projects.filter((p) => p.category === c.key).length }))
  .filter((c) => c.n > 0);
const fan = [
  { src: `${base}/portfolio/ai-visibility-store.webp`, w: 1440, h: 900, style: '--i:0;--r:5deg;--r0:9deg;width:62%;top:5%;right:1%' },
  { src: `${base}/portfolio/pdfold-home.webp`, w: 1440, h: 900, style: '--i:1;--r:-6deg;--r0:-10deg;width:62%;top:18%;right:34%' },
  { src: `${base}/portfolio/piktechs-home.webp`, w: 1440, h: 900, style: '--i:2;--r:2deg;--r0:5deg;width:66%;top:40%;right:12%' },
];
---

<Layout
  title="Portfolio - El Mahdi Moubarak"
  description="Selected work: SaaS products, web apps, e-commerce and mobile applications built by El Mahdi Moubarak."
>
  <PageHero eyebrow="Portfolio">
    <h1 class="t-page">
      <span class="rise"><span style="--i:0">Built and</span></span>
      <span class="rise"><span style="--i:1">shipped</span></span>
    </h1>
    <p class="t-lede hero__lede fade-up" style="--i:1">
      SaaS products, web apps, e-commerce stores and mobile apps I designed, built and shipped.
    </p>
    <p class="t-meta mt-6 fade-up" style="--i:2">Open a project to preview it.</p>
    <div slot="visual" class="fan" aria-hidden="true">
      {fan.map((f) => (
        <div class="fan__item" style={f.style}><img src={f.src} alt="" width={f.w} height={f.h} /></div>
      ))}
    </div>
  </PageHero>

  <div class="sticky top-[var(--header-h)] z-30 bg-[color-mix(in_srgb,var(--bg)_88%,transparent)] backdrop-blur-md border-b border-[var(--line)]">
    <div class="wrap py-3 md:py-4 flex items-center justify-between gap-4">
      <div class="filters filters--scroll w-full" role="group" aria-label="Filter projects by category">
        {categories.map((c) => (
          <button type="button" class="filter" data-filter={c.key} aria-pressed={c.key === 'all' ? 'true' : 'false'}>
            {c.label}<span class="filter__n">{c.n}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="wrap py-[clamp(2.5rem,5vw,4.5rem)] pb-[var(--section)]">
    <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-[clamp(1.25rem,2.4vw,2.25rem)]">
      {projects.map((p, i) => (
        <article
          class="card portfolio-card cursor-pointer"
          data-previews={JSON.stringify(p.previews)}
          data-url={p.url}
          data-title={p.title}
          data-category={p.category}
          data-reveal
          style={`--i:${i % 2}`}
        >
          <div class="card__media">
            <img src={p.thumb} alt={`${p.title}: ${p.subtitle}`} width="1600" height="1000" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="card__body">
            <div class="flex items-center justify-between gap-3 t-meta">
              <span>{p.categoryLabel}</span>
              <span class="text-right">{p.role}</span>
            </div>
            <h2 class="t-h3 card__title mt-4"><button type="button" class="card__hit" aria-label={`Preview ${p.title}`}>{p.title}</button></h2>
            <p class:list={['t-meta mt-2', { italic: !p.url }]}>{p.subtitle}</p>
            <p class="text-2 leading-relaxed mt-5">{p.description}</p>
            <div class="chips mt-6">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
            <span class="link-arrow mt-auto pt-7" aria-hidden="true">Preview <Icon name="arrow" /></span>
          </div>
        </article>
      ))}
    </div>
    <p id="no-results" class="hidden text-center text-[var(--muted)] py-16">No project in this category.</p>
  </section>

  <!-- Preview modal -->
  <div id="demo-modal" class="modal fixed inset-0 z-[60] hidden overflow-y-auto" style="overscroll-behavior:contain;-webkit-overflow-scrolling:touch;">
    <div class="modal__backdrop" aria-hidden="true"></div>
    <div class="relative flex min-h-full items-center justify-center p-0 md:p-8">
      <div id="demo-modal-dialog" class="modal__dialog w-full md:w-[min(92vw,1400px)] max-h-[100dvh] md:max-h-[90vh] flex flex-col overflow-hidden">
        <div class="flex items-center justify-between gap-3 pl-5 pr-3 py-3 border-b border-[var(--line)] shrink-0">
          <span id="demo-modal-title" class="font-[family-name:var(--font-display)] font-bold text-lg tracking-tight truncate">Preview</span>
          <div class="flex items-center gap-2 shrink-0">
            <a id="demo-visit-link" href="#" target="_blank" rel="noopener noreferrer" class="hidden btn btn--solid btn--sm">Visit site <Icon name="out" /></a>
            <button id="close-demo-modal" type="button" class="icon-btn" aria-label="Close preview">
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>
        <!-- Preview tabs: only rendered when a project has more than one preview -->
        <div id="demo-tabs" class="hidden flex-wrap gap-2 px-5 py-3 border-b border-[var(--line)] shrink-0" role="group" aria-label="Preview"></div>
        <div id="demo-modal-body" class="flex-1 min-h-0 overflow-y-auto bg-[var(--bg-2)]" style="overscroll-behavior:contain;-webkit-overflow-scrolling:touch;">
          <iframe id="demo-iframe" src="about:blank" title="Live preview" class="w-full block hidden" style="height:80vh;border:0;" allowfullscreen></iframe>
          <!-- Image preview: full width, natural height → vertical scroll for long captures -->
          <img id="demo-img" alt="Preview" class="w-full block hidden" style="height:auto;" />
          <video id="demo-video" class="w-full block hidden bg-black" style="height:auto;" muted loop playsinline autoplay controls preload="metadata"></video>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    .modal__backdrop { position: fixed; inset: 0; background: rgb(15 16 18 / 0.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .modal__dialog { background: var(--bg); border: 1px solid var(--line); box-shadow: var(--shadow-lg); }
    @media (min-width: 768px) { .modal__dialog { border-radius: var(--radius); } }
    .modal:not(.hidden) .modal__backdrop { animation: modal-fade 0.35s var(--ease-out) both; }
    .modal:not(.hidden) .modal__dialog { animation: modal-in 0.5s var(--ease-out) both; }
    @keyframes modal-fade { from { opacity: 0; } }
    @keyframes modal-in { from { opacity: 0; transform: translateY(24px) scale(0.98); } }
    #cards-grid .card.is-wide { grid-column: 1 / -1; }
    .card__hit { font: inherit; letter-spacing: inherit; color: inherit; text-align: left; cursor: pointer; }
    .card__hit::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
    .card__hit:focus-visible { outline: none; }
    .card:has(.card__hit:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
    .card.is-hiding { display: none; }
  </style>

  <script is:inline>
    // ===== Filters =====
    // An odd number of visible cards would leave one alone on the last row: the first one goes wide instead.
    (function () {
      var grid = document.getElementById('cards-grid');
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-category]'));
      var buttons = document.querySelectorAll('.filter[data-filter]');
      var wideQuery = window.matchMedia('(min-width: 768px)');
      function layout() {
        var visible = cards.filter(function (c) { return !c.classList.contains('is-hiding'); });
        cards.forEach(function (c) { c.classList.remove('is-wide', 'card--wide'); });
        if (wideQuery.matches && visible.length % 2 === 1) visible[0].classList.add('is-wide', 'card--wide');
        document.getElementById('no-results').classList.toggle('hidden', visible.length > 0);
      }
      function apply(filter) {
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.filter === filter)); });
        cards.forEach(function (card) {
          var show = filter === 'all' || card.dataset.category === filter;
          card.classList.toggle('is-hiding', !show);
          if (show) { card.classList.remove('is-in'); requestAnimationFrame(function () { card.classList.add('is-in'); }); }
        });
        layout();
      }
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var run = function () { apply(btn.dataset.filter); };
          if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(run);
          else run();
        });
      });
      wideQuery.addEventListener('change', layout);
      layout();
    })();

    // ===== Preview modal =====
    (function () {
      const modal = document.getElementById('demo-modal');
      const dialog = document.getElementById('demo-modal-dialog');
      const iframe = document.getElementById('demo-iframe');
      const demoImg = document.getElementById('demo-img');
      const demoVideo = document.getElementById('demo-video');
      const tabsBar = document.getElementById('demo-tabs');
      const modalBody = document.getElementById('demo-modal-body');
      const modalTitle = document.getElementById('demo-modal-title');
      const visitLink = document.getElementById('demo-visit-link');
      const closeBtn = document.getElementById('close-demo-modal');
      if (!modal) return;

      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-labelledby', 'demo-modal-title');
      modal.setAttribute('tabindex', '-1');

      let lastFocusedElement = null;
      let savedScrollY = 0;

      const isImageUrl = (url) => /\.(webp|png|jpg|jpeg|gif|svg)(\?.*)?$/i.test(url);
      const isVideoUrl = (url) => /\.(mp4|webm|mov)(\?.*)?$/i.test(url);

      function lockBodyScroll() {
        savedScrollY = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = '-' + savedScrollY + 'px';
        document.body.style.width = '100%';
      }

      function unlockBodyScroll() {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        // Bypass the site's `scroll-behavior: smooth` so the restore is instant,
        // otherwise closing the modal visibly scrolls down from the top.
        const html = document.documentElement;
        const prev = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        window.scrollTo(0, savedScrollY);
        html.style.scrollBehavior = prev;
      }

      // Tear down every media slot so a closed/switched preview stops loading and decoding.
      function resetMedia() {
        // about:blank, not '' — an empty src resolves against the page URL and reloads
        // this whole page into the hidden iframe on every open and tab switch.
        iframe.src = 'about:blank';
        iframe.classList.add('hidden');
        demoImg.removeAttribute('src');
        demoImg.classList.add('hidden');
        demoVideo.pause();
        demoVideo.removeAttribute('src');
        demoVideo.removeAttribute('poster');
        demoVideo.load();
        demoVideo.classList.add('hidden');
      }

      function showPreview(preview) {
        resetMedia();
        const url = preview.src;
        if (isVideoUrl(url)) {
          if (preview.poster) demoVideo.poster = preview.poster;
          demoVideo.src = url;
          demoVideo.classList.remove('hidden');
          demoVideo.play().catch(() => {});
        } else if (isImageUrl(url)) {
          demoImg.src = url;
          demoImg.classList.remove('hidden');
        } else {
          iframe.src = url;
          iframe.classList.remove('hidden');
        }
        modalBody.scrollTop = 0;
      }

      function clearTabs() {
        tabsBar.replaceChildren();
        tabsBar.classList.add('hidden');
        tabsBar.classList.remove('flex');
      }

      function buildTabs(previews) {
        clearTabs();
        if (previews.length < 2) return;
        tabsBar.classList.remove('hidden');
        tabsBar.classList.add('flex');
        previews.forEach((preview, i) => {
          const tab = document.createElement('button');
          tab.type = 'button';
          tab.textContent = preview.label;
          tab.className = 'filter preview-tab';
          tab.setAttribute('aria-pressed', String(i === 0));
          tab.addEventListener('click', () => {
            tabsBar.querySelectorAll('.preview-tab').forEach((t) => {
              t.setAttribute('aria-pressed', String(t === tab));
            });
            showPreview(preview);
          });
          tabsBar.appendChild(tab);
        });
      }

      function openModal(previews, externalUrl, title) {
        if (!previews || previews.length === 0) return;
        lastFocusedElement = document.activeElement;
        modalTitle.textContent = title || 'Preview';
        const first = previews[0];
        const linkUrl = externalUrl || (/^https?:\/\//i.test(first.src) ? first.src : null);
        if (linkUrl) {
          visitLink.href = linkUrl;
          visitLink.classList.remove('hidden');
        } else {
          visitLink.classList.add('hidden');
        }
        buildTabs(previews);
        showPreview(first);
        modal.scrollTop = 0;
        modal.classList.remove('hidden');
        lockBodyScroll();
        modal.focus();
      }

      function closeModal() {
        modal.classList.add('hidden');
        resetMedia();
        clearTabs();
        visitLink.href = '#';
        visitLink.classList.add('hidden');
        unlockBodyScroll();
        if (lastFocusedElement) lastFocusedElement.focus();
      }

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (!dialog.contains(e.target)) closeModal();
      });

      // Focus trap + Escape (document-level so the iframe doesn't block it)
      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
        if (e.key !== 'Tab') return;
        const focusable = Array.from(modal.querySelectorAll(
          "button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])"
        )).filter((el) => !el.classList.contains('hidden'));
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // Card triggers: the title is a real button stretched over the card, so keyboard and clicks both land here
      function trigger(el) {
        let previews;
        try {
          previews = JSON.parse(el.dataset.previews);
        } catch {
          return;
        }
        openModal(previews, el.dataset.url || null, el.dataset.title || null);
      }
      document.querySelectorAll('.portfolio-card[data-previews]').forEach((card) => {
        card.addEventListener('click', () => trigger(card));
      });
    })();
  </script>
</Layout>
