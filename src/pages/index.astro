---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { services as allServices, projects as allProjects } from '../data/profile.js';
// The homepage shows three headline lines only. The other four (MVP rescue, self-hosted
// agents, corporate AI training, technical Shopify) stay in the mother source and on /kit,
// where they feed Malt and Upwork.
const homeServices = ['SaaS & Web Apps', 'AI Automation & Agents', 'LLM & RAG Integration'];
const services = homeServices.map((t) => allServices.find((s) => s.title === t)).filter(Boolean);
const featured = ['Piktechs', 'PDFold', 'AI Search Visibility Tracker', 'Mon Jouet Montessori'];
const projects = featured.map((t) => allProjects.find((p) => p.title === t)).filter(Boolean);
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stack = ["TypeScript", "Python", "Angular", "Vue.js", "React Native", "Next.js", "Django", "Node.js", "AWS", "Docker", "PostgreSQL", "CI/CD"];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="El Mahdi Moubarak - Founder & Full-Stack Engineer">
  <!-- Intro -->
  <section class="mb-16">
    <div class="flex items-center gap-6 md:gap-10 mb-6">
      <div>
        <p class="font-mono text-xs text-muted mb-4">Founder & Full-Stack Engineer · Software, SaaS & AI</p>
        <h1 class="text-3xl md:text-4xl leading-tight">
          El Mahdi <span class="text-accent">Moubarak</span>
        </h1>
      </div>
      <img
        src={`${base}/profile-picture.webp`}
        alt="Portrait of El Mahdi Moubarak"
        width="400"
        height="400"
        class="w-32 h-32 md:w-44 md:h-44 rounded-full b-border object-cover shrink-0"
        decoding="async"
      />
    </div>
    <p class="text-base leading-relaxed max-w-2xl mb-8 text-body">
      I build software and AI systems end-to-end: specs, architecture, code, deploy.
      6 years across cybersecurity, healthcare and fintech, mostly as the only engineer
      on the project. I work with founders and agencies who need something built
      properly and shipped fast.
    </p>
    <p class="font-mono text-xs text-muted mb-8">
      Based in Lille, France · Remote across Europe · French (native) &amp; English
    </p>

    <div class="flex flex-wrap gap-3">
      <a href={`${base}/cv`} class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-accent text-white border-ink hover:bg-accent-alt transition-colors inline-block">
        View CV
      </a>
      <a href="https://calendly.com/moubarakelmahdipro/" target="_blank" class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block">
        Book a Call
      </a>
      <a href="mailto:elmahdi@moubarak.dev" class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block">
        Get in touch
      </a>
    </div>
  </section>

  <!-- Services -->
  <section class="mb-16">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-4">What I Do</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {services.map((s) => (
        <div class="b-border p-5 bg-paper dark:bg-dark-surface flex flex-col">
          <h3 class="font-mono text-sm font-bold mb-2">{s.title}</h3>
          <p class="text-sm text-body leading-relaxed flex-1">{s.description}</p>
          <p class="font-mono text-[0.65rem] text-accent font-bold mt-4">{s.audience}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest">Projects</h2>
      <a href={`${base}/portfolio`} class="font-mono text-xs text-muted hover:text-accent transition-colors">
        full portfolio →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((p) => (
        <Card
          title={p.title}
          description={p.description}
          href={p.href}
          tags={p.tags}
        />
      ))}
    </div>
  </section>

  <!-- Trust -->
  <section class="mb-16">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-4">They Trust Me</h2>

    <div class="b-border bg-paper dark:bg-dark-surface p-6 md:flex md:items-start gap-6 mb-4">
      <img
        src={`${base}/driveco-training.webp`}
        alt="Corporate AI training session delivered at DRIVECO"
        width="800"
        height="800"
        class="b-border w-full md:w-52 h-auto mb-4 md:mb-0 shrink-0"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="text-sm leading-relaxed text-body italic mb-4">
          “Learning how to use AI effectively is becoming a real lever for efficiency and impact.
          During our ChatGPT Workshop, ‘Make AI work for you’, we explored how AI can support us
          from the very first question to the automation of a complete business process.”
        </p>
        <p class="font-mono text-xs font-bold">DRIVECO · HR Director</p>
        <p class="font-mono text-[0.65rem] text-muted mb-3">on LinkedIn, after the corporate AI training I delivered</p>
        <a
          href="https://www.linkedin.com/posts/el-mahdi-moubarak_merci-%C3%A0-toute-l%C3%A9quipe-driveco-de-mavoir-share-7480266785208926210-AIX7/"
          target="_blank"
          class="font-mono text-xs underline underline-offset-2 hover:text-accent transition-colors"
        >
          Read the post on LinkedIn ↗
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="b-border p-5 bg-paper dark:bg-dark-surface flex flex-col">
        <h3 class="font-mono text-sm font-bold mb-2">Agency work · KSUR Services</h3>
        <p class="text-sm text-body leading-relaxed flex-1 mb-3">
          As CTO of KSUR Services, I own technical delivery for the agency's clients:
          websites, e-commerce and web apps shipped for SMEs in France and Morocco.
        </p>
        <a
          href="https://www.agence-ksur.com/realisations"
          target="_blank"
          class="font-mono text-xs underline underline-offset-2 hover:text-accent transition-colors"
        >
          See the agency portfolio ↗
        </a>
      </div>
      <div class="b-border p-5 bg-paper dark:bg-dark-surface">
        <h3 class="font-mono text-sm font-bold mb-3">Companies I've built for</h3>
        <div class="flex flex-wrap gap-1.5">
          {["DRIVECO", "Board of Cyber", "ALTAO Santé", "Worldline", "Deuspi", "KSUR Services"].map((c) => (
            <span class="tag">{c}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest">Writing</h2>
      <a href={`${base}/blog`} class="font-mono text-xs text-muted hover:text-accent transition-colors">
        all posts →
      </a>
    </div>
    <div class="space-y-3">
      {latestPosts.map((post) => (
        <a href={`${base}/blog/${post.id}`} class="flex items-baseline justify-between gap-4 py-2 border-b border-ink/10 dark:border-dark-border group">
          <span class="font-mono text-sm font-medium group-hover:text-accent transition-colors">{post.data.title}</span>
          <span class="font-mono text-[0.65rem] text-muted shrink-0">
            {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section>
    <div class="b-border p-6 bg-paper-alt dark:bg-dark-surface">
      <p class="font-mono text-sm font-bold mb-1">Let's connect</p>
      <p class="text-sm text-muted mb-4">Open to interesting projects and conversations.</p>
      <div class="flex flex-wrap gap-3 font-mono text-xs">
        <a href="mailto:elmahdi@moubarak.dev" class="underline underline-offset-2 hover:text-accent transition-colors">elmahdi@moubarak.dev</a>
        <span class="text-muted">·</span>
        <a href="https://linkedin.com/in/el-mahdi-moubarak" target="_blank" class="underline underline-offset-2 hover:text-accent transition-colors">LinkedIn</a>
        <span class="text-muted">·</span>
        <a href="https://github.com/emoubarak" target="_blank" class="underline underline-offset-2 hover:text-accent transition-colors">GitHub</a>
      </div>
    </div>
  </section>
</Layout>
