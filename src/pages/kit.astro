    .filter-empty {
      opacity: 0.35;
    }
  </style>

  <script is:inline>
    const filterState = { section: 'all', project: 'all' };

    function applyFilters() {
      // Per-item project visibility
      document.querySelectorAll('[data-project]').forEach((el) => {
        el.style.display = (filterState.project === 'all' || el.dataset.project === filterState.project) ? '' : 'none';
      });
      // Section visibility: matches the section filter AND has content for the active project
      document.querySelectorAll('[data-section]').forEach((section) => {
        const sectionOk = filterState.section === 'all' || section.dataset.section === filterState.section;
        const projectOk = filterState.project === 'all' || !!section.querySelector(`[data-project="${filterState.project}"]`);
        section.style.display = sectionOk && projectOk ? '' : 'none';
      });
      document.querySelectorAll('.section-filter-btn').forEach((b) => {
        const key = b.dataset.sectionFilter;
        b.classList.toggle('filter-active', key === filterState.section);
        const empty = key !== 'all' && filterState.project !== 'all'
          && !document.querySelector(`[data-section="${key}"] [data-project="${filterState.project}"]`);
        b.classList.toggle('filter-empty', empty);
      });
      document.querySelectorAll('.project-filter-btn').forEach((b) => {
        b.classList.toggle('filter-active', b.dataset.projectFilter === filterState.project);
      });
    }

    document.querySelectorAll('.section-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        filterState.section = btn.dataset.sectionFilter;
        applyFilters();
      });
    });

    document.querySelectorAll('.project-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        filterState.project = btn.dataset.projectFilter;
        filterState.section = 'all';
        applyFilters();
      });
    });

    // Download an image asset in the requested format (served as-is if it already matches, else converted via canvas)
    async function downloadImage(src, format) {
      const name = src.split('/').pop().replace(/\.[^.]+$/, '') + '.' + format;
      const ext = src.split('.').pop().toLowerCase();
      let href = src;
      let objectUrl = null;
      if (ext !== format) {
        const img = new Image();
        img.src = src;
        await img.decode();
        // SVGs have no intrinsic raster size worth keeping: render them at 1024px minimum
        const scale = ext === 'svg' ? Math.max(1, 1024 / (img.naturalWidth || 1024)) : 1;
        const canvas = document.createElement('canvas');
        canvas.width = Math.round((img.naturalWidth || 1024) * scale);
        canvas.height = Math.round((img.naturalHeight || 1024) * scale);
        canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, `image/${format}`, 0.92));
        href = objectUrl = URL.createObjectURL(blob);
      }
      const link = document.createElement('a');
      link.href = href;
      link.download = name;
      document.body.appendChild(link);
      link.click();
      link.remove();
      if (objectUrl) setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
    }

    document.querySelectorAll('.img-dl-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const original = btn.textContent;
        btn.textContent = '…';
        btn.disabled = true;
        try {
          await downloadImage(btn.dataset.src, btn.dataset.format);
        } catch (e) {
          console.error(e);
        }
        btn.textContent = original;
        btn.disabled = false;
      });
    });

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const el = document.getElementById(btn.dataset.target);
        if (!el) return;
        await navigator.clipboard.writeText(el.innerText);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        btn.classList.add('bg-accent', 'text-white', 'border-accent');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('bg-accent', 'text-white', 'border-accent');
        }, 1500);
      });
    });
  </script>
