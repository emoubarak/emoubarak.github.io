<Layout
  title="Profile Kit - El Mahdi Moubarak"
  description="Canonical profile content - bios, experience and projects in EN/FR."
  noindex
  contained
>
  <!-- Header -->
  <section class="mb-12">
    <h1 class="text-2xl font-extrabold mb-1">Profile Kit</h1>
    <p class="font-mono text-xs text-muted mb-4">
      Canonical, copy-paste-ready versions of my bio, experience and projects - EN & FR.
      Single source of truth for freelance platforms (Malt, Upwork, LinkedIn…).
    </p>
    <p class="font-mono text-[0.65rem] text-muted">
      Hidden page - not linked in the nav, not indexed.
    </p>
  </section>

  <!-- Filters -->
  <div class="sticky top-[var(--header-h)] z-40 bg-paper dark:bg-dark-paper py-3 mb-9 border-b-2 border-ink dark:border-dark-border space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[0.6rem] text-muted uppercase tracking-widest w-14 shrink-0">Section</span>
      {[
        { key: 'all', label: 'All' },
        { key: 'assets', label: 'Assets' },
        { key: 'identity', label: 'Identity' },
        { key: 'bios', label: 'Bios' },
        { key: 'featured', label: 'Featured' },
        { key: 'experience', label: 'Experience' },
        { key: 'projects', label: 'Projects' },
        { key: 'skills', label: 'Skills' },
        { key: 'education', label: 'Education' },
      ].map((f) => (
        <button
          class:list={['section-filter-btn font-mono text-[0.65rem] font-bold b-border px-3 py-1.5 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors', { 'filter-active': f.key === 'all' }]}
          data-section-filter={f.key}
        >
          {f.label}
        </button>
      ))}
    </div>
    <div class="flex flex-wrap items-start gap-2">
      <span class="font-mono text-[0.6rem] text-muted uppercase tracking-widest w-full sm:w-14 shrink-0 sm:pt-2">Project</span>
      <div class="flex flex-col gap-2 min-w-0 flex-1">
        {projectFilterGroups.map((g) => (
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[0.6rem] text-muted w-full sm:w-24 shrink-0">{g.label}</span>
            {g.filters.map((f) => (
              <button
                class:list={['project-filter-btn font-mono text-[0.65rem] font-bold b-border px-3 py-1.5 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors', { 'filter-active': f.key === 'all' }]}
                data-project-filter={f.key}
              >
                {f.label}
              </button>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Assets -->
  <section class="mb-12" data-section="assets">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Assets</h2>

    <div class="mb-8" data-project="brand">
      <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Documents</p>
      <div class="flex flex-wrap gap-3">
        {docAssets.map((a) => (
          <a
            href={`${base}/${a.file}`}
            download
            class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block"
          >
            {a.label} ↓
          </a>
        ))}
      </div>
    </div>

    {assetGroups.map((g) => (
      <div class="mb-8" data-project={g.key}>
        <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">
          {g.name}
          {g.link && (
            <a href={g.link} target="_blank" class="font-normal normal-case tracking-normal text-accent hover:text-accent-alt ml-2">{g.link.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a>
          )}
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {g.assets.map((a) => (
            <div class="b-border bg-paper dark:bg-dark-surface flex flex-col">
              <div class="relative h-28 overflow-hidden border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper shrink-0">
                <img
                  src={`${base}/${a.poster ?? a.file}`}
                  alt={`${g.name} - ${a.label}`}
                  class="absolute inset-0 w-full h-full object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute top-1.5 left-1.5 font-mono text-[0.55rem] font-bold uppercase tracking-wider px-1.5 py-0.5 bg-paper dark:bg-dark-surface b-border">{a.type}</span>
              </div>
              <div class="flex items-center justify-between gap-2 px-3 py-2 flex-1">
                <span class="font-mono text-[0.65rem] leading-snug">{a.label}</span>
                {a.type === 'Motion' ? (
                  <a
                    href={`${base}/${a.file}`}
                    download
                    class="font-mono text-[0.65rem] font-bold b-border px-2 py-1 shrink-0 bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors"
                  >
                    MP4 ↓
                  </a>
                ) : (
                  <div class="flex gap-1 shrink-0">
                    {['webp', 'png'].map((fmt) => (
                      <button
                        type="button"
                        class="img-dl-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors uppercase"
                        data-src={`${base}/${a.file}`}
                        data-format={fmt}
                      >
                        {fmt} ↓
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div data-project="brand">
      <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Links</p>
      <div class="space-y-4">
        {linkBlocks.map((b) => (
          <div class="b-border bg-paper dark:bg-dark-surface">
            <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
              <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.label}</span>
