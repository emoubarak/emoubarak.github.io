  'case-study-ai-card-scanner': ["Étude de cas : choisir le modèle de repli d'un LLM en l'attaquant", "Le scanner de cartes de visite de Piktechs lit la carte d'un inconnu avec un modèle de vision. Comment j'ai choisi son modèle de repli par un test d'injection de prompt avant de comparer les prix, et les garde-fous qui permettent d'exposer sans risque un endpoint LLM payant."],
  'case-study-jev-check': ["Étude de cas : account-state-check, une QA par agent navigateur où la base de données rend le verdict", "Les tests unitaires et les suites de tests de bout en bout à base de mocks ratent les bugs où le front déployé, le backend et les permissions se contredisent. J'ai construit un outil de QA par agent navigateur qui se connecte à l'app de test déployée sous un compte dans un état exact et vérifie le résultat dans la base de données, puis je l'ai publié en open source comme skill d'agent."],
  'what-i-kept-telling-claude': ["Ce que je répétais sans cesse à Claude : quatre mois de mes propres corrections", "J'ai relu environ 4 000 de mes propres prompts, sur quatre mois et deux machines, et retrouvé les six mêmes corrections dans chaque projet. Les écrire ne suffisait pas : une règle qu'un script peut vérifier va maintenant dans un hook, et le reste dans le fichier le plus ciblé qui marche."],
  'browser-agents-at-work-jev': ["Des agents navigateur au travail : QA, consoles web et relais pour les mots de passe avec jev", "J'utilise jev, l'agent navigateur de Browser Use, tous les jours : pour tester mon propre SaaS sous chaque type de compte, pour travailler dans des consoles web sans API, et pour me rendre la main quand un mot de passe est demandé. Les cas d'usage, l'architecture et dix leçons de mise en place."],
  'lazy-by-design': ["La flemme comme méthode : ce qu'il faut à un agent avant que je le laisse seul", "Si je fais une chose deux fois, une machine la fait la troisième. Comment cela devient des exécutions d'agents avec une condition d'arrêt vérifiable et un plafond de dépense, des tâches planifiées qui rendent compte, et une seule source pour chaque information."],
  'the-great-work-polymarket': ["Le Grand Œuvre : j'ai essayé de transformer des pile ou face sur le Bitcoin en or", "J'ai donné à mes bots de trading simulé des noms de mystiques et d'alchimistes, je les ai lancés sur les marchés Bitcoin à cinq minutes de Polymarket, et j'ai passé juin à voir chaque avantage redevenir du plomb. Un récit satirique du marché efficient, en cinq étapes alchimiques."],
  'how-i-built-pdfold': ["Comment j'ai construit PDFold seul : un espace de travail Claude avec une boucle de correction, des tests et une infra sans surprise", "La configuration derrière PDFold : un espace de travail Claude que je corrigeais après chaque raté, des tests écrits avec chaque fonctionnalité, et un pipeline PDF vers Markdown en deux passes sur Gemini, passé sur OpenRouter en août."],
};
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredSections = featuredIds
  .map((id) => blogPosts.find((p) => p.id === id))
  .filter(Boolean)
  .map((p) => {
    const url = `https://moubarak.dev/blog/${p.id}`;
    const [frTitle, frDesc] = featuredFr[p.id] ?? [p.data.title, p.data.description];
    return {
      label: p.data.title,
      blocks: pair({ en: `${p.data.title}\n${url}\n${p.data.description}`, fr: `${frTitle} (en anglais)\n${url}\n${frDesc}` }),
    };
  });
const expSections = experiences.map((e) => ({ label: e.label, project: e.project, blocks: pair(e) }));
const projSections = projects.map((p) => ({ label: p.label, project: p.project, link: p.link, blocks: pair(p) }));
const serviceBlocks = pair(services);
const proofBlocks = pair(proof);
const testimonialBlocks = pair(testimonials);
const skillBlocks = pair(skills);
const eduBlocks = pair(education);
---

<Layout
  title="Profile Kit - El Mahdi Moubarak"
  description="Copy-paste versions of my bio, experience and projects, in English and French."
  noindex
  contained
>
  <!-- Header -->
  <section class="mb-12">
    <h1 class="text-2xl font-extrabold mb-1">Profile Kit</h1>
    <p class="font-mono text-xs text-muted mb-4">
      Copy-paste versions of my bio, experience and projects, in English and French, for Malt, Upwork and LinkedIn.
    </p>
    <p class="font-mono text-[0.65rem] text-muted">
      Hidden page: not in the menu, not indexed.
    </p>
  </section>

  <!-- Filters -->
  <div class="sticky top-[var(--header-h)] z-40 bg-paper dark:bg-dark-paper py-3 mb-9 border-b-2 border-ink dark:border-dark-border space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-[0.6rem] text-muted uppercase tracking-widest w-14 shrink-0">Section</span>
      {[
        { key: 'all', label: 'All' },
        { key: 'assets', label: 'Assets' },
        { key: 'identity', label: 'Identity' },
        { key: 'bios', label: 'Bios' },
        { key: 'featured', label: 'Featured' },
        { key: 'experience', label: 'Experience' },
        { key: 'projects', label: 'Projects' },
        { key: 'skills', label: 'Skills' },
        { key: 'education', label: 'Education' },
      ].map((f) => (
        <button
          class:list={['section-filter-btn font-mono text-[0.65rem] font-bold b-border px-3 py-1.5 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors', { 'filter-active': f.key === 'all' }]}
          data-section-filter={f.key}
        >
          {f.label}
        </button>
      ))}
    </div>
    <div class="flex flex-wrap items-start gap-2">
      <span class="font-mono text-[0.6rem] text-muted uppercase tracking-widest w-full sm:w-14 shrink-0 sm:pt-2">Project</span>
      <div class="flex flex-col gap-2 min-w-0 flex-1">
        {projectFilterGroups.map((g) => (
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[0.6rem] text-muted w-full sm:w-24 shrink-0">{g.label}</span>
            {g.filters.map((f) => (
              <button
                class:list={['project-filter-btn font-mono text-[0.65rem] font-bold b-border px-3 py-1.5 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors', { 'filter-active': f.key === 'all' }]}
                data-project-filter={f.key}
              >
                {f.label}
              </button>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Assets -->
  <section class="mb-12" data-section="assets">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Assets</h2>

    <div class="mb-8" data-project="brand">
      <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Documents</p>
      <div class="flex flex-wrap gap-3">
        {docAssets.map((a) => (
          <a
            href={`${base}/${a.file}`}
            download
            class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block"
          >
            {a.label} ↓
          </a>
        ))}
      </div>
    </div>

    {assetGroups.map((g) => (
      <div class="mb-8" data-project={g.key}>
        <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">
          {g.name}
          {g.link && (
            <a href={g.link} target="_blank" class="font-normal normal-case tracking-normal text-accent hover:text-accent-alt ml-2">{g.link.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a>
          )}
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {g.assets.map((a) => (
            <div class="b-border bg-paper dark:bg-dark-surface flex flex-col">
              <div class="relative h-28 overflow-hidden border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper shrink-0">
                <img
                  src={`${base}/${a.poster ?? a.file}`}
                  alt={`${g.name} - ${a.label}`}
                  class="absolute inset-0 w-full h-full object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute top-1.5 left-1.5 font-mono text-[0.55rem] font-bold uppercase tracking-wider px-1.5 py-0.5 bg-paper dark:bg-dark-surface b-border">{a.type}</span>
              </div>
              <div class="flex items-center justify-between gap-2 px-3 py-2 flex-1">
                <span class="font-mono text-[0.65rem] leading-snug">{a.label}</span>
                {a.type === 'Motion' ? (
                  <a
                    href={`${base}/${a.file}`}
                    download
                    class="font-mono text-[0.65rem] font-bold b-border px-2 py-1 shrink-0 bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors"
                  >
                    MP4 ↓
                  </a>
                ) : (
                  <div class="flex gap-1 shrink-0">
                    {['webp', 'png'].map((fmt) => (
                      <button
                        type="button"
                        class="img-dl-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors uppercase"
                        data-src={`${base}/${a.file}`}
                        data-format={fmt}
                      >
                        {fmt} ↓
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div data-project="brand">
      <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Links</p>
      <div class="space-y-4">
        {linkBlocks.map((b) => (
          <div class="b-border bg-paper dark:bg-dark-surface">
            <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
              <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.label}</span>
              <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
            </div>
            <pre id={b.id} class="whitespace-pre-wrap font-mono text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Identity -->
  <section class="mb-12" data-section="identity">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Identity & Contact</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {identityCards.map((card) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{card.lang}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={card.copyAllId}>Copy all</button>
          </div>
          <pre id={card.copyAllId} class="hidden">{card.copyAllText}</pre>
          <div>
            {identityFields.map((f) => (
              <div class="flex items-center justify-between gap-3 px-3 py-2 border-b border-ink/10 dark:border-dark-border last:border-b-0">
                <div class="min-w-0">
                  <p class="font-mono text-[0.6rem] text-muted uppercase tracking-widest mb-0.5">{f.label[card.langKey]}</p>
                  <p id={f[card.idKey]} class="font-mono text-xs text-body break-all">{f.value[card.langKey]}</p>
                </div>
                <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer shrink-0 bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={f[card.idKey]}>Copy</button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Bios -->
  <section class="mb-12" data-section="bios">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Bios</h2>
    <div class="space-y-8">
      {bioSections.map((s) => (
        <div>
          <h3 class="font-mono text-sm font-bold mb-3">{s.label}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured -->
  <section class="mb-12 scroll-mt-56" id="featured" data-section="featured" data-project="writing">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-2">Featured · case studies & articles</h2>
    <p class="text-xs text-muted mb-6">For LinkedIn Featured, Malt and proposals: title, link, one-line summary.</p>
    <div class="space-y-8">
      {featuredSections.map((s) => (
        <div>
          <h3 class="font-mono text-sm font-bold mb-3">{s.label}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="mb-12" data-section="experience">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Experience</h2>
    <div class="space-y-8">
      {expSections.map((s) => (
        <div data-project={s.project}>
          <h3 class="font-mono text-sm font-bold mb-3">{s.label}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="mb-12" data-section="projects">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Projects</h2>
    <div class="space-y-8">
      {projSections.map((s) => (
        <div data-project={s.project}>
          <h3 class="font-mono text-sm font-bold mb-3">
            {s.label}
            <a href={s.link} target="_blank" class="font-normal text-accent hover:text-accent-alt text-xs ml-2">↗</a>
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
