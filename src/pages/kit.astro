  { label: { en: 'Calendly', fr: 'Calendly' }, value: { en: 'https://calendly.com/moubarakelmahdipro/', fr: 'https://calendly.com/moubarakelmahdipro/' } },
  { label: { en: 'Languages', fr: 'Langues' }, value: { en: 'French (native) · English (C1, TOEIC) · Spanish (professional)', fr: 'Français (natif) · Anglais (C1, TOEIC) · Espagnol (professionnel)' } },
  { label: { en: 'Available for', fr: 'Disponible pour' }, value: { en: 'freelance missions · SaaS & AI development · automation · tech consulting', fr: 'missions freelance · développement SaaS & IA · automatisation · conseil tech' } },
].map((f) => ({ ...f, idEn: uid(), idFr: uid() }));

const identityCards = [
  { lang: 'EN', langKey: 'en', idKey: 'idEn', copyAllId: identityBlocks[0].id, copyAllText: identityBlocks[0].text },
  { lang: 'FR', langKey: 'fr', idKey: 'idFr', copyAllId: identityBlocks[1].id, copyAllText: identityBlocks[1].text },
];
const bioSections = bios.map((b) => ({ label: b.label, blocks: pair(b) }));
const expSections = experiences.map((e) => ({ label: e.label, blocks: pair(e) }));
const projSections = projects.map((p) => ({ label: p.label, link: p.link, blocks: pair(p) }));
const skillBlocks = pair(skills);
const eduBlocks = pair(education);
---

<Layout
  title="Profile Kit - El Mahdi Moubarak"
  description="Canonical profile content - bios, experience and projects in EN/FR."
  noindex
>
  <!-- Header -->
  <section class="mb-12">
    <h1 class="text-2xl font-extrabold mb-1">Profile Kit</h1>
    <p class="font-mono text-xs text-muted mb-4">
      Canonical, copy-paste-ready versions of my bio, experience and projects - EN & FR.
      Single source of truth for freelance platforms (Malt, Upwork, LinkedIn…).
    </p>
    <p class="font-mono text-[0.65rem] text-muted">
      Hidden page - not linked in the nav, not indexed.
    </p>
  </section>

  <!-- Filters -->
  <div class="sticky top-[66px] z-40 bg-paper dark:bg-dark-paper py-3 mb-9 border-b-2 border-ink dark:border-dark-border flex flex-wrap gap-2">
    {[
      { key: 'all', label: 'All' },
      { key: 'assets', label: 'Assets' },
      { key: 'identity', label: 'Identity' },
      { key: 'bios', label: 'Bios' },
      { key: 'experience', label: 'Experience' },
      { key: 'projects', label: 'Projects' },
      { key: 'skills', label: 'Skills' },
      { key: 'education', label: 'Education' },
    ].map((f) => (
      <button
        class:list={['filter-btn font-mono text-[0.65rem] font-bold b-border px-3 py-1.5 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors', { 'filter-active': f.key === 'all' }]}
        data-filter={f.key}
      >
        {f.label}
      </button>
    ))}
  </div>

  <!-- Assets -->
  <section class="mb-12" data-section="assets">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Assets</h2>

    <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Documents</p>
    <div class="flex flex-wrap gap-3 mb-8">
      {docAssets.map((a) => (
        <a
          href={`${base}/${a.file}`}
          download
          class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block"
        >
          {a.label} ↓
        </a>
      ))}
    </div>

    <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Images</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
      {imageAssets.map((a) => (
        <div class="b-border bg-paper dark:bg-dark-surface flex flex-col">
          <div class="relative h-28 overflow-hidden border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper shrink-0">
            <img
              src={`${base}/${a.file}`}
              alt={a.label}
              class="absolute inset-0 w-full h-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex items-center justify-between gap-2 px-3 py-2 flex-1">
            <span class="font-mono text-[0.65rem] leading-snug">{a.label}</span>
            <a
              href={`${base}/${a.file}`}
              download
              class="font-mono text-[0.65rem] font-bold b-border px-2 py-1 shrink-0 bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors"
            >
              ↓
            </a>
          </div>
        </div>
      ))}
    </div>

    <p class="font-mono text-[0.65rem] font-bold text-muted uppercase tracking-widest mb-3">Links</p>
    <div class="space-y-4">
      {linkBlocks.map((b) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.label}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
          </div>
          <pre id={b.id} class="whitespace-pre-wrap font-mono text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
        </div>
      ))}
    </div>
  </section>

  <!-- Identity -->
  <section class="mb-12" data-section="identity">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Identity & Contact</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {identityCards.map((card) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{card.lang}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={card.copyAllId}>Copy all</button>
          </div>
          <pre id={card.copyAllId} class="hidden">{card.copyAllText}</pre>
          <div>
            {identityFields.map((f) => (
              <div class="flex items-center justify-between gap-3 px-3 py-2 border-b border-ink/10 dark:border-dark-border last:border-b-0">
                <div class="min-w-0">
                  <p class="font-mono text-[0.6rem] text-muted uppercase tracking-widest mb-0.5">{f.label[card.langKey]}</p>
                  <p id={f[card.idKey]} class="font-mono text-xs text-body break-all">{f.value[card.langKey]}</p>
                </div>
                <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer shrink-0 bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={f[card.idKey]}>Copy</button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Bios -->
  <section class="mb-12" data-section="bios">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Bios</h2>
    <div class="space-y-8">
      {bioSections.map((s) => (
        <div>
          <h3 class="font-mono text-sm font-bold mb-3">{s.label}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="mb-12" data-section="experience">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Experience</h2>
    <div class="space-y-8">
      {expSections.map((s) => (
        <div>
          <h3 class="font-mono text-sm font-bold mb-3">{s.label}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="mb-12" data-section="projects">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Projects</h2>
    <div class="space-y-8">
      {projSections.map((s) => (
        <div>
          <h3 class="font-mono text-sm font-bold mb-3">
            {s.label}
            <a href={s.link} target="_blank" class="font-normal text-accent hover:text-accent-alt text-xs ml-2">↗</a>
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {s.blocks.map((b) => (
              <div class="b-border bg-paper dark:bg-dark-surface">
                <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
                  <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
                  <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
                </div>
                <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="mb-12" data-section="skills">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Skills</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      {skillBlocks.map((b) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
          </div>
          <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
        </div>
      ))}
    </div>
    <div class="space-y-4">
      {linkedinSkills.map((b) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.label}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
          </div>
          <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section class="mb-12" data-section="education">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Education</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {eduBlocks.map((b) => (
        <div class="b-border bg-paper dark:bg-dark-surface">
          <div class="flex items-center justify-between px-3 py-2 border-b-2 border-ink dark:border-dark-border bg-paper-alt dark:bg-dark-paper">
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest">{b.lang}</span>
            <button class="copy-btn font-mono text-[0.65rem] font-bold b-border px-2 py-1 cursor-pointer bg-paper dark:bg-dark-surface hover:bg-accent hover:text-white hover:border-accent transition-colors" data-target={b.id}>Copy</button>
          </div>
          <pre id={b.id} class="whitespace-pre-wrap font-sans text-xs leading-relaxed p-3 text-body overflow-x-auto">{b.text}</pre>
        </div>
      ))}
    </div>
  </section>

  <style>
    .filter-btn.filter-active {
      background: var(--color-accent);
      color: #fff;
      border-color: var(--color-accent);
    }
  </style>

  <script is:inline>
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        document.querySelectorAll('.filter-btn').forEach((b) => {
          b.classList.toggle('filter-active', b === btn);
        });
        document.querySelectorAll('[data-section]').forEach((section) => {
          section.style.display = (filter === 'all' || section.dataset.section === filter) ? '' : 'none';
        });
      });
    });

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const el = document.getElementById(btn.dataset.target);
        if (!el) return;
        await navigator.clipboard.writeText(el.innerText);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        btn.classList.add('bg-accent', 'text-white', 'border-accent');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('bg-accent', 'text-white', 'border-accent');
        }, 1500);
      });
    });
  </script>
</Layout>
