  <!-- Service lines -->
  <section class="mb-12" data-section="services">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Service lines</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
