---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { experiences, education, techGroups, interests, projects, aiEngineering } from '../data/profile.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="CV - El Mahdi Moubarak" description="Full CV - El Mahdi Moubarak, Founder & Full-Stack Engineer.">
  <!-- Header -->
  <section class="mb-12">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-extrabold mb-1">Curriculum Vitae</h1>
        <p class="font-mono text-xs text-muted">El Mahdi Moubarak - Founder & Full-Stack Engineer · Software, SaaS & AI</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="https://calendly.com/moubarakelmahdipro/"
          target="_blank"
          class="font-mono text-xs font-bold b-border px-4 py-2 b-lift bg-paper dark:bg-dark-surface hover:bg-paper-alt transition-colors inline-block"
        >
          Book a Call
        </a>
        <a
          href={`${base}/cv-en.pdf`}
          download
          class="font-mono text-xs font-bold b-border px-4 py-2 b-shadow b-lift bg-accent text-white border-ink hover:bg-accent-alt transition-colors inline-block"
        >
          PDF (EN) ↓
        </a>
        <a
          href={`${base}/cv-fr.pdf`}
          download
          class="font-mono text-xs font-bold b-border px-4 py-2 b-shadow b-lift bg-accent text-white border-ink hover:bg-accent-alt transition-colors inline-block"
        >
          PDF (FR) ↓
        </a>
      </div>
    </div>

    <p class="text-sm leading-relaxed text-body">
      I build software and AI systems end-to-end: specs, architecture, code, deploy.
      6 years across cybersecurity, healthcare and fintech, mostly as the only engineer on the project.
      I work with founders and agencies who need something built properly and shipped fast.
    </p>
  </section>

  <!-- AI Engineering -->
  <section class="mb-12 scroll-mt-24" id="ai-engineering">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-3">AI Engineering</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      {aiEngineering.highlights.map((h) => (
        <div class="b-border b-shadow bg-paper dark:bg-dark-surface p-3">
          <div class="font-mono text-xl md:text-2xl font-extrabold text-accent leading-none mb-1.5">{h.value}</div>
          <div class="text-xs text-body leading-snug">{h.label}</div>
        </div>
      ))}
    </div>
    <p class="text-sm leading-relaxed text-body mb-6">
      {aiEngineering.intro.en}
      <a href={`${base}/blog#case-studies`} class="font-mono text-xs font-bold text-accent hover:text-accent-alt whitespace-nowrap ml-1">Read the case studies →</a>
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {aiEngineering.capabilities.map((c) => (
        <div class="b-border bg-paper dark:bg-dark-surface p-5 flex flex-col">
          <h3 class="font-mono text-sm font-bold mb-3 leading-snug">{c.title}</h3>
          <ul class="space-y-2 mb-4">
            {c.points.map((pt) => (
              <li class="text-sm flex items-start gap-2">
                <span class="text-accent font-mono text-xs mt-0.5 shrink-0">▪</span>
                <span class="text-body">{pt}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-3 border-t border-ink/10 dark:border-dark-border flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-mono text-[0.65rem] text-muted">{c.evidence}</span>
            {c.link && <a href={`${base}${c.link.href}`} class="font-mono text-[0.7rem] font-bold text-accent hover:text-accent-alt">{c.link.label} →</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="mb-12">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Experience</h2>
    <div class="space-y-8">
      {experiences.map((exp) => (
        <div class="relative pl-5 border-l-2 border-ink dark:border-dark-border">
          <div class="absolute left-[-5px] top-1 w-2 h-2 bg-accent"></div>
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1">
            <h3 class="font-mono text-sm font-bold">
              {exp.company} <span class="font-normal text-muted">· {exp.role}</span>
            </h3>
            <span class="font-mono text-[0.65rem] text-muted shrink-0">{exp.period}</span>
          </div>
          <p class="text-xs text-muted mb-2">{exp.location}</p>
          <p class="text-sm mb-3">{exp.summary}</p>
          <ul class="space-y-1.5">
            {exp.achievements.map((a) => (
              <li class="text-sm flex items-start gap-2">
                <span class="text-accent font-mono text-xs mt-0.5 shrink-0">▪</span>
                <span class="text-body">{a}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section class="mb-12">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Education</h2>
    <div class="space-y-4">
      {education.map((edu) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-4 border-b border-ink/10 dark:border-dark-border">
          <div>
            <h3 class="font-mono text-sm font-bold">{edu.degree}</h3>
            <p class="text-xs text-muted">{edu.school} - {edu.detail}</p>
          </div>
          <span class="font-mono text-[0.65rem] text-muted shrink-0">{edu.period}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Technical Stack -->
  <section class="mb-12">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Technical Expertise</h2>
    <div class="space-y-4">
      {techGroups.map((g) => (
        <div>
          <p class="font-mono text-[0.65rem] text-muted mb-2">{g.label}</p>
          <div class="flex flex-wrap gap-1.5">
            {g.items.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="mb-12">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((p) => (
        <Card
          title={p.title}
          description={p.description}
          href={p.url}
          tags={p.tags}
        />
      ))}
    </div>
  </section>

  <!-- Interests -->
  <section class="mb-12">
    <h2 class="font-mono text-xs font-bold text-muted uppercase tracking-widest mb-6">Beyond Code</h2>
    <div class="space-y-2">
      {interests.map((int) => (
        <p class="text-sm">
          <span class="font-mono font-bold">{int.title}</span>
          <span class="text-muted"> - </span>
          <span class="text-body">{int.detail}</span>
        </p>
      ))}
    </div>
  </section>

  <!-- Download CTA -->
  <section>
    <div class="b-border p-6 bg-paper-alt dark:bg-dark-surface text-center">
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href={`${base}/cv-en.pdf`}
          download
          class="font-mono text-xs font-bold b-border px-6 py-3 b-lift bg-accent text-white border-ink hover:bg-accent-alt transition-colors inline-block"
        >
          Download CV - English ↓
        </a>
        <a
          href={`${base}/cv-fr.pdf`}
          download
          class="font-mono text-xs font-bold b-border px-6 py-3 b-lift bg-accent text-white border-ink hover:bg-accent-alt transition-colors inline-block"
        >
          Télécharger le CV - Français ↓
        </a>
      </div>
    </div>
  </section>
</Layout>
