---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const caseStudies = sortedPosts.filter((p) => p.data.tags.includes('Case Study')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const articles = sortedPosts.filter((p) => !p.data.tags.includes('Case Study'));
const [featured, ...others] = caseStudies;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (c: string) => (c.startsWith('/') ? `${base}${c}` : c);
const shortTitle = (t: string) => t.replace(/^Case Study:\s*/, '');
const minutes = (body = '') => Math.max(2, Math.round(body.split(/\s+/).length / 230));
// hero card: the newest post, cover and title only
const [latest] = sortedPosts;
---

<Layout title="Blog - El Mahdi Moubarak" description="Case studies and articles on AI engineering, Claude Code, browser agents and shipping products." ogImage="/og/blog.png">
  <PageHero eyebrow="Blog">
    <h1 class="t-page">
      <span class="rise"><span style="--i:0">Notes from</span></span>
      <span class="rise"><span style="--i:1">the work</span></span>
    </h1>
    <p class="t-lede hero__lede fade-up" style="--i:1">Case studies from real projects, and what building with AI every day taught me.</p>
    <div class="hero__actions fade-up" style="--i:2">
      <a href="#case-studies" class="btn btn--solid">Case studies <Icon name="down" /></a>
      <a href="#articles" class="btn btn--line">Articles</a>
    </div>
    <div slot="visual" class="hero-feature fade-up" style="--i:2">
      <div class="latest">
        <a href={`${base}/blog/${latest.id}`} class="latest__main">
          {latest.data.cover && <span class="latest__media"><img src={src(latest.data.cover)} alt={latest.data.coverAlt ?? ''} width="1200" height="630" /></span>}
          <span class="latest__body">
            <span class="t-meta">Latest</span>
            <span class="latest__title">{shortTitle(latest.data.title)}</span>
          </span>
        </a>
      </div>
    </div>
  </PageHero>

  {caseStudies.length > 0 && (
    <section class="wrap section" id="case-studies">
      <div class="s-head">
        <div>
          <p class="t-eyebrow">From real projects</p>
          <h2 class="t-h2">Case studies</h2>
        </div>
      </div>

      {featured && (
        <a href={`${base}/blog/${featured.id}`} class="card card--wide mb-[clamp(1.25rem,2.4vw,2.25rem)]" data-reveal>
          {featured.data.cover && (
            <div class="card__media"><img src={src(featured.data.cover)} alt={featured.data.coverAlt ?? ''} loading="eager" /></div>
          )}
          <div class="card__body">
            <p class="t-meta">Case study · {minutes(featured.body)} min read</p>
            <h3 class="t-h3 card__title mt-4">{shortTitle(featured.data.title)}</h3>
            <p class="text-2 leading-relaxed mt-5">{featured.data.description}</p>
            <span class="link-arrow mt-8">Read the case study <Icon name="arrow" /></span>
          </div>
        </a>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-[clamp(1.25rem,2.4vw,2.25rem)]">
        {others.map((p, i) => (
          <a href={`${base}/blog/${p.id}`} class="card" data-reveal style={`--i:${i}`}>
            {p.data.cover && (
              <div class="card__media card__media--fit"><img src={src(p.data.cover)} alt={p.data.coverAlt ?? ''} loading="lazy" /></div>
            )}
            <div class="card__body">
              <p class="t-meta">Case study · {minutes(p.body)} min read</p>
              <h3 class="t-h4 card__title mt-3">{shortTitle(p.data.title)}</h3>
              <p class="text-2 leading-relaxed mt-4 line-clamp-3">{p.data.description}</p>
              <span class="link-arrow mt-auto pt-6">Read <Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section" id="articles">
    <div class="s-head">
      <div>
        <p class="t-eyebrow">Writing</p>
        <h2 class="t-h2">Articles</h2>
      </div>
    </div>
    {articles.length === 0 ? (
      <p class="text-[var(--muted)]">Nothing here yet.</p>
    ) : (
      <PostList posts={articles} dateStyle="long" />
    )}
  </section>
</Layout>
