---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (c: string) => (c.startsWith('/') ? `${base}${c}` : c);
const minutes = Math.max(2, Math.round((post.body ?? '').split(/\s+/).length / 230));
const toc = headings.filter((h) => h.depth === 2);
const others = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout title={`${post.data.title} - El Mahdi Moubarak`} description={post.data.description} ogImage={`/og/blog/${post.id}.png`} published={post.data.pubDate}>
  <div class="progress" aria-hidden="true" data-progress></div>
  <article>
    <!-- the shared hero: title on the left, the cover on the right (under the title on phones) -->
    <PageHero as="header" class="hero--post">
      <a href={`${base}/blog`} class="link-arrow text-[0.95rem] fade-up" style="--i:0"><Icon name="back" /> Blog</a>
      <h1 class="post-title mt-7 fade-up" style="--i:1">{post.data.title}</h1>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 fade-up" style="--i:2">
        <time class="t-meta" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span class="t-meta">{minutes} min read</span>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag: string) => <span class="chip !bg-white/40 !border-black/10 !text-[#14161a]">{tag}</span>)}
          </div>
        )}
      </div>
      {post.data.cover && (
        <div slot="visual" class="hero-feature fade-up" style="--i:3">
          <a href={src(post.data.cover)} target="_blank" rel="noopener" title="Open full size" class="post-cover">
            <img src={src(post.data.cover)} alt={post.data.coverAlt ?? post.data.title} loading="eager" />
          </a>
        </div>
      )}
    </PageHero>

    <div class="wrap pt-[clamp(3rem,6vw,5rem)] pb-[var(--section)] xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,46rem)_minmax(0,1fr)] xl:gap-x-12">
      <aside class="hidden xl:block">
        {toc.length > 2 && (
          <nav class="toc sticky top-[calc(var(--header-h)+2.5rem)] max-w-[15rem]" aria-label="In this article" data-toc>
            <p class="t-eyebrow mb-4">In this article</p>
            {toc.map((h) => <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>)}
          </nav>
        )}
      </aside>

      <div class="min-w-0 max-w-[46rem] mx-auto xl:mx-0">
        {post.data.tldr.length > 0 && (
          <aside class="tldr mb-12" aria-label="In short">
            <p class="t-eyebrow mb-4">In short</p>
            <ul class="text-[1.05rem] leading-relaxed">
              {post.data.tldr.map((t) => <li>{t}</li>)}
            </ul>
          </aside>
        )}

        <div class="prose-content">
          <Content />
        </div>

        <footer class="mt-16 pt-8 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-4">
          <a href={`${base}/blog`} class="link-arrow"><Icon name="back" /> All posts</a>
          <a href="https://calendly.com/moubarakelmahdipro/" target="_blank" rel="noopener noreferrer" class="btn btn--solid btn--sm">Book a call <Icon name="arrow" /></a>
        </footer>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="wrap pb-[var(--section)]">
      <p class="t-eyebrow mb-3">Keep reading</p>
      <h2 class="t-h2 mb-10">Next posts</h2>
      <div class="grid md:grid-cols-2 gap-[clamp(1.25rem,2.4vw,2.25rem)]">
        {others.map((p, i) => (
          <a href={`${base}/blog/${p.id}`} class="card" data-reveal style={`--i:${i}`}>
            {p.data.cover && <div class="card__media card__media--fit"><img src={src(p.data.cover)} alt="" loading="lazy" /></div>}
            <div class="card__body">
              <p class="t-meta">{p.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
              <h3 class="t-h4 card__title mt-3">{p.data.title}</h3>
              <p class="text-2 leading-relaxed mt-3 line-clamp-2">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      var bar = document.querySelector('[data-progress]');
      var body = document.querySelector('.prose-content');
      var links = document.querySelectorAll('[data-toc-link]');
      var heads = Array.prototype.map.call(links, function (l) { return document.getElementById(l.dataset.tocLink); }).filter(Boolean);
      var tick = false;
      function update() {
        tick = false;
        if (body) {
          var r = body.getBoundingClientRect();
          var p = (window.innerHeight * 0.5 - r.top) / r.height;
          bar.style.setProperty('--p', Math.max(0, Math.min(1, p)).toFixed(4));
        }
        if (heads.length) {
          var current = null, y = window.innerHeight * 0.3;
          heads.forEach(function (h) { if (h.getBoundingClientRect().top < y) current = h.id; });
          links.forEach(function (l) { l.classList.toggle('is-active', l.dataset.tocLink === current); });
        }
      }
      update();
      window.addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener('resize', update);
    })();
  </script>
</Layout>
