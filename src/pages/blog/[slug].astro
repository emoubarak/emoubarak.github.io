---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${post.data.title} - El Mahdi Moubarak`} description={post.data.description}>
  <article>
    <header class="mb-10">
      <a href={`${base}/blog`} class="font-mono text-xs text-muted hover:text-accent transition-colors mb-6 inline-block">
        ← back
      </a>
      <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-3">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3">
        <time class="font-mono text-xs text-muted" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.tags.length > 0 && (
          <>
            <span class="text-muted">·</span>
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    {post.data.cover && (
      <figure class="mb-8 b-border b-shadow bg-paper dark:bg-dark-surface overflow-hidden">
        <a href={post.data.cover.startsWith('/') ? `${base}${post.data.cover}` : post.data.cover} target="_blank" rel="noopener" title="Open full size">
          <img src={post.data.cover.startsWith('/') ? `${base}${post.data.cover}` : post.data.cover} alt={post.data.coverAlt ?? post.data.title} class="w-full h-auto block" loading="eager" />
        </a>
      </figure>
    )}

    {post.data.tldr.length > 0 && (
      <aside class="mb-10 border-l-4 border-accent pl-5 py-1" aria-label="In short">
        <p class="font-mono text-[0.65rem] font-bold uppercase tracking-widest text-muted mb-3">In short</p>
        <ul class="space-y-2">
          {post.data.tldr.map((t) => (
            <li class="text-sm text-body leading-relaxed">{t}</li>
          ))}
        </ul>
      </aside>
    )}

    <div class="prose-content">
      <Content />
    </div>

    <footer class="mt-12 pt-6 border-t-2 border-ink dark:border-dark-border">
      <a href={`${base}/blog`} class="font-mono text-xs text-muted hover:text-accent transition-colors">
        ← all posts
      </a>
    </footer>
  </article>
</Layout>
